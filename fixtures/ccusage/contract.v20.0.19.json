{
  "tool": "ccusage",
  "version": "20.0.19",
  "version_output": "ccusage 20.0.19",
  "observed_on": "2026-08-04",
  "source": "local npm cache",
  "report_scope": "codex",
  "offline_required": true,
  "speed_override": {
    "automatic": "--speed auto",
    "standard": "--speed standard",
    "fast": "--speed fast"
  },
  "commands": {
    "daily": {
      "argv": [
        "ccusage",
        "codex",
        "daily",
        "--json",
        "--offline",
        "--speed",
        "auto"
      ],
      "top_level": {
        "type": "object",
        "keys": ["daily", "totals"]
      },
      "rows": {
        "field": "daily",
        "type": "array<object>",
        "keys": [
          "cacheCreationTokens",
          "cacheReadTokens",
          "costUSD",
          "date",
          "inputTokens",
          "models",
          "outputTokens",
          "reasoningOutputTokens",
          "totalTokens"
        ],
        "model_breakdown": {
          "type": "object keyed by model name",
          "keys": [
            "cacheCreationTokens",
            "cacheReadTokens",
            "inputTokens",
            "isFallback",
            "outputTokens",
            "reasoningOutputTokens",
            "totalTokens"
          ]
        }
      },
      "totals": {
        "type": "object",
        "keys": [
          "cacheCreationTokens",
          "cacheReadTokens",
          "costUSD",
          "inputTokens",
          "outputTokens",
          "reasoningOutputTokens",
          "totalTokens"
        ]
      }
    },
    "session": {
      "argv": [
        "ccusage",
        "codex",
        "session",
        "--json",
        "--offline",
        "--speed",
        "auto"
      ],
      "top_level": {
        "type": "object",
        "keys": ["sessions", "totals"]
      },
      "rows": {
        "field": "sessions",
        "type": "array<object>",
        "keys": [
          "cacheCreationTokens",
          "cacheReadTokens",
          "costUSD",
          "directory",
          "inputTokens",
          "lastActivity",
          "models",
          "outputTokens",
          "reasoningOutputTokens",
          "sessionFile",
          "sessionId",
          "totalTokens"
        ],
        "model_breakdown": {
          "type": "object keyed by model name",
          "keys": [
            "cacheCreationTokens",
            "cacheReadTokens",
            "inputTokens",
            "isFallback",
            "outputTokens",
            "reasoningOutputTokens",
            "totalTokens"
          ]
        }
      },
      "totals": {
        "type": "object",
        "keys": [
          "cacheCreationTokens",
          "cacheReadTokens",
          "costUSD",
          "inputTokens",
          "outputTokens",
          "reasoningOutputTokens",
          "totalTokens"
        ]
      }
    }
  },
  "bridge_rules": [
    "Treat costUSD as a numeric result whose unit is selected by the active pricing override and pricing_scheme.",
    "Run auto and standard independently for each pricing scheme; Fast surcharge is max(auto - standard, 0).",
    "Persist sessionId, token fields, pricing scheme, pricing version, and ccusage version; do not persist directory or sessionFile contents into public responses."
  ]
}
